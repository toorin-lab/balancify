# Balancify v3 configuration. One "key = value" per line; '#' starts a comment.
# Any key can be overridden on the command line with --set key=value.

# --- identity -----------------------------------------------------------------
service            = video          # all instances of one VIP share this name
instance_id        = lb1            # unique per instance; no '.', '/' or spaces

# --- forwarding -----------------------------------------------------------------
mode               = balancify      # balancify | all_stateful | stateless
vip                = 10.0.0.100
vip_ports          = 80,443         # empty: every port
local_ip           = 10.0.1.11      # outer source of IP-in-IP; answered in ARP
gateway_mac        = 3c:fd:fe:00:00:01
port_id            = 0
workers            = 0              # 0: one forwarding core per EAL worker lcore
rx_desc            = 1024
tx_desc            = 1024
mbufs_per_worker   = 16384

# --- consistent hashing -----------------------------------------------------------
hashing            = stable         # stable (bucket table shared via ZooKeeper) | maglev
buckets            = 65536
maglev_table_size  = 65537

# --- override rule and monitoring (Algorithms 1 and 2) ------------------------------
threshold          = 20             # T: percentage points (cpu) or ms (latency)
load_signal        = cpu            # cpu | latency
sampling_interval  = 10             # tau, seconds
target_rule        = r1             # r0 argmin | r1 argmin + increment | r2 random below average
r1_increment       = 0              # 0: estimate per-connection load from agent reports
load_aggregation   = mean           # mean of the reports in each interval | last report
health_timeout_ms  = 1000           # a DIP leaves the pool this long after its agent stops reporting
health_requires_agent = true
agent_bind         = 0.0.0.0
agent_port         = 7001

# --- connection-to-DIP table ------------------------------------------------------
idle_timeout_s     = 300
fin_linger_ms      = 2000
table_cache_share  = 0.75           # share of the cache budget given to the tables
table_budget_mb    = 0              # without a CAT partition; 0: LLC size

# --- Intel CAT --------------------------------------------------------------------
cat_partition_mb   = 8              # 0: no partition
cat_cos            = 1
cat_way_offset     = 0
cat_isolate_others = false          # true: keep every other process out of the partition
cat_interface      = os             # os (resctrl) | msr

# --- Bloom filter -----------------------------------------------------------------
bloom              = auto           # auto: only while the table exceeds the cache budget | on | off
bloom_fp_rate      = 0.01

# --- coordination store (omit zk_hosts for a single instance) -------------------------
zk_hosts           = 10.0.2.1:2181,10.0.2.2:2181,10.0.2.3:2181
zk_root            = /balancify
zk_session_timeout_ms = 6000
zk_write_timeout_ms   = 50
zk_sync_timeout_ms    = 30000
zk_orphan_timeout_s   = 0           # 0: idle_timeout_s

# --- operations -------------------------------------------------------------------
announce_cmd       = /opt/balancify/scripts/announce_vip.sh up
withdraw_cmd       = /opt/balancify/scripts/announce_vip.sh down
shutdown_grace_ms  = 2000
control_bind       = 127.0.0.1
control_port       = 8080
stats_log          = /var/log/balancify/stats.csv
stats_log_interval_ms = 1000

# --- backend pool: dip = <name> <ip> [<mac>|-] [<weight>] ---------------------------
# '-' sends the encapsulated packet to gateway_mac (routed DIPs).
dip = video-01 10.0.3.1 - 1
dip = video-02 10.0.3.2 - 1
dip = video-03 10.0.3.3 - 1
dip = video-04 10.0.3.4 - 1
dip = video-05 10.0.3.5 - 1
dip = video-06 10.0.3.6 - 1
dip = video-07 10.0.3.7 - 1
dip = video-08 10.0.3.8 - 1
dip = video-09 10.0.3.9 - 1
dip = video-10 10.0.3.10 - 1
dip = video-11 10.0.3.11 - 1
dip = video-12 10.0.3.12 - 1
dip = video-13 10.0.3.13 - 1
dip = video-14 10.0.3.14 - 1
dip = video-15 10.0.3.15 - 1
dip = video-16 10.0.3.16 - 1
